# SPCR (Student Progression & Company Relation) — Environment Configuration Template
# SECURITY RULE: Never commit live secrets or paste them into AI chats.
# In production, set secret values directly in Render Dashboard -> Environment.

NODE_ENV=development
PORT=3000

# Public HTTPS origin of the SPCR web service (used for strict CORS, OAuth callbacks, and extension origin checks)
APP_BASE_URL=http://localhost:3000

# Single-owner dashboard gate (REQUIRED in production): only this verified Google identity may sign into SPCR
SPCR_OWNER_EMAIL=tpo@example.edu

# Local demo authentication toggle (MUST be false in production; hard-blocked by code when NODE_ENV=production)
SPCR_DEMO_AUTH_ENABLED=true

# Database:
# - Production (Render PostgreSQL): postgresql://user:pass@host:5432/spcr
# - Local zero-dependency PostgreSQL (PGlite WASM): pglite://./.data/spcr-pg
DATABASE_URL=pglite://./.data/spcr-pg

# Generated Application Secrets (generate via `npm run generate:secrets`, 32+ random bytes hex/base64)
# Leave blank in local demo mode ONLY to auto-generate ephemeral process keys; REQUIRED in production.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
WORKER_SHARED_SECRET=

# Google Cloud OAuth 2.0 (Web Application Client)
# Required for Google OIDC owner sign-in and (after policy gate) Gmail API sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# CRITICAL COMPLIANCE GATE:
# Keep false until Google API Services User Data Policy & restricted-scope (`gmail.readonly`) CASA / OAuth verification
# requirements are confirmed for this hosted deployment. When false, live mailbox sync stays disabled and synthetic fixtures work.
GMAIL_POLICY_GATE_APPROVED=false

# Groq Post-Screen Extraction & Drafting (NEVER used during email scanning/classification)
# Leave GROQ_API_KEY blank to keep Groq in unconfigured/mock-safe mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_LIVE_ENABLED=false

# Local Self-Hosted Classifier Cache Directory
CLASSIFIER_CACHE_DIR=./.models_cache
CLASSIFIER_OFFLINE_ONLY=false

# Attachment & Storage Quotas (PostgreSQL encrypted BYTEA shared between web and worker)
MAX_ATTACHMENT_BYTES=5242880
MAX_TOTAL_ATTACHMENT_STORAGE_BYTES=262144000
MAX_PDF_PAGES=25
MAX_EXTRACTED_CHARS=60000
ATTACHMENT_PARSE_TIMEOUT_MS=5000

# Chrome/Edge Extension Build Target Origin (used by `npm run build:extension`)
EXTENSION_BACKEND_ORIGIN=https://your-spcr-service.onrender.com

