# SPCR (Student Progression & Company Relation) — Zero-Cost Environment Configuration Template
# RECURRING COST INVARIANT: ₹0 third-party software & API bill. Zero payment method required to run SPCR.
# SECURITY RULE: Never commit live secrets or paste them into AI chats.

NODE_ENV=development
PORT=3000

# Operating Mode:
# - LOCAL_ZERO_COST (default): All classification, extraction, matching, and PGlite storage run 100% locally at ₹0 cost.
# - FREE_CLOUD_OPTIONAL: Free-tier cloud demo mode (documents sleep, quota, and 30-day DB expiry limits).
SPCR_OPERATING_MODE=LOCAL_ZERO_COST

# Public origin of the SPCR web service (used for strict CORS, OAuth callbacks, and extension origin checks)
APP_BASE_URL=http://localhost:3000

# Single-owner dashboard gate (REQUIRED in production): only this verified Google identity may sign into SPCR
SPCR_OWNER_EMAIL=tpo@example.edu

# Local demo authentication toggle (MUST be false in production; hard-blocked by code when NODE_ENV=production)
SPCR_DEMO_AUTH_ENABLED=true

# Database:
# - LOCAL_ZERO_COST (default, zero external server/cost): pglite://./.data/spcr-pg
# - FREE_CLOUD_OPTIONAL (approved free-tier PostgreSQL): postgresql://user:pass@host:5432/spcr
DATABASE_URL=pglite://./.data/spcr-pg

# Generated Application Secrets (generate via `npm run generate:secrets`, 32+ random bytes hex)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
WORKER_SHARED_SECRET=

# Google Cloud OAuth 2.0 (Optional in LOCAL_ZERO_COST demo/manual fixture mode; required only if connecting Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# CRITICAL COMPLIANCE & QUOTA GATES:
# Keep false until Google API Services User Data Policy & restricted-scope (`gmail.readonly`) CASA / Internal Workspace
# requirements are confirmed. Local mode works without Gmail API access.
GMAIL_POLICY_GATE_APPROVED=false
GMAIL_DAILY_QUOTA_SAFETY_LIMIT_UNITS=10000
GMAIL_PER_SYNC_MAX_QUOTA_UNITS=500
# Optional local sync interval (seconds) active ONLY while the owner's computer and SPCR process are running (0 = manual sync)
LOCAL_SYNC_INTERVAL_SECONDS=0

# Optional Groq Drafting (`OPTIONAL_GROQ` — disabled by default; NEVER used for classification or required for extraction)
GROQ_LIVE_ENABLED=false
GROQ_FREE_TIER_ONLY=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local Supervised Recruitment Email Intelligence Model & Pretrained ONNX Cache
EMAIL_MODEL_ARTIFACT_PATH=./ml/artifacts/recruitment_email_model_v1.json
CLASSIFIER_CACHE_DIR=./.models_cache
CLASSIFIER_OFFLINE_ONLY=false

# Attachment & Storage Quotas (PostgreSQL/PGlite encrypted BYTEA)
MAX_ATTACHMENT_BYTES=5242880
MAX_TOTAL_ATTACHMENT_STORAGE_BYTES=262144000
MAX_PDF_PAGES=25
MAX_EXTRACTED_CHARS=60000
ATTACHMENT_PARSE_TIMEOUT_MS=5000

# Chrome/Edge Extension Build Target Origin (used by `npm run build:extension`)
EXTENSION_BACKEND_ORIGIN=http://localhost:3000
